rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRating(val) {
      return val is int && val >= 1 && val <= 5;
    }

    function isValidSurveyResponse(data) {
      return data.keys().hasAll(['q1', 'q2', 'q3', 'q4', 'q5', 'createdAt'])
        && data.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'comment', 'createdAt'])
        && isValidRating(data.q1)
        && isValidRating(data.q2)
        && isValidRating(data.q3)
        && isValidRating(data.q4)
        && isValidRating(data.q5)
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000))
        && data.createdAt == request.time;
    }

    match /responses/{responseId} {
      allow get: if isValidId(responseId);
      allow list: if true;
      allow create: if isValidId(responseId) && isValidSurveyResponse(request.resource.data);
      allow update, delete: if false;
    }
  }
}
